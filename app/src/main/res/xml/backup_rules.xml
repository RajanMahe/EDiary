<?xml version="1.0" encoding="utf-8"?>
<!--
   Android's own cloud backup (Android 11 and older).
   The diary database is encrypted with a key that can't leave this phone,
   so neither is backed up here: use the app's Backup & Restore instead.
-->
<full-backup-content>
    <exclude domain="database" path="diary_db" />
    <exclude domain="database" path="diary_db-wal" />
    <exclude domain="database" path="diary_db-shm" />
    <exclude domain="sharedpref" path="kurippidu_db_key.xml" />
</full-backup-content>
